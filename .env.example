DATABASE_URL=postgresql+psycopg://saps_api:password@localhost:5432/saps_case_docket
MIGRATION_DATABASE_URL=postgresql+psycopg://saps_owner:password@localhost:5432/saps_case_docket
ENVIRONMENT=development
# Generate strong local values; never commit .env or use these placeholders.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ENCRYPTION_KEY=
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
MFA_CHALLENGE_EXPIRE_MINUTES=5
# Private evidence storage, never served as static files or committed to Git.
# Default storage directory is .evidence-storage under the project root.
# EVIDENCE_STORAGE_PATH=C:/private/saps-evidence
EVIDENCE_MAX_FILE_BYTES=26214400
# Private generated confirmations; never mount as static content.
# DOCUMENT_STORAGE_PATH=C:/private/saps-documents
# Prototype operational thresholds, not statutory deadlines.
ALERT_INACTIVITY_DAYS=7
ALERT_DOCKET_APPROVAL_HOURS=48
ALERT_ESCALATION_HOURS=24
